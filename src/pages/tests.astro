---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import TestsExplorer from '../components/TestsExplorer.astro';
import Icon from '../components/Icon.astro';
import T from '../components/T.astro';
---
<Base title={{ en: 'Tests & Prices', bn: 'টেস্ট ও মূল্য' }}>
  <PageHero title={{ en: 'Tests & prices', bn: 'টেস্ট ও মূল্য' }} lead={{ en: 'Search the full list or choose a category. Every test shows its price, report time and preparation.', bn: 'পূর্ণ তালিকা খুঁজুন বা ক্যাটাগরি বেছে নিন। প্রতিটি টেস্টের মূল্য, রিপোর্টের সময় ও প্রস্তুতি দেওয়া আছে।' }} />
  <section class="section section-flush">
    <div class="wrap"><TestsExplorer /></div>
  </section>
  <section class="wrap">
    <div class="cta">
      <div><h2><T en="Not sure which test you need?" bn="কোন টেস্ট দরকার বুঝতে পারছেন না?" /></h2><p><T en="Your doctor’s prescription decides the tests. You can also book a doctor first." bn="কোন টেস্ট লাগবে তা ডাক্তারের প্রেসক্রিপশনই ঠিক করে। আপনি আগে ডাক্তারের সিরিয়ালও নিতে পারেন।" /></p></div>
      <a class="btn btn-light btn-lg" href="/appointment"><Icon name="calendar" size={20} /> <T en="Book a doctor" bn="ডাক্তারের সিরিয়াল" /></a>
    </div>
  </section>
</Base>
