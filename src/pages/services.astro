---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import T from '../components/T.astro';
import { services } from '../data/services';
import { site } from '../data/site';

const withImg = services.filter((s) => s.image);
const rest = services.filter((s) => !s.image);
const steps = [
  { t: { en: 'Choose', bn: 'বেছে নিন' }, d: { en: 'Pick a doctor or a test from the website.', bn: 'ওয়েবসাইট থেকে ডাক্তার বা টেস্ট বেছে নিন।' } },
  { t: { en: 'Book', bn: 'সিরিয়াল' }, d: { en: 'Request a serial on WhatsApp or by phone.', bn: 'হোয়াটসঅ্যাপ বা ফোনে সিরিয়াল নিন।' } },
  { t: { en: 'Visit', bn: 'আসুন' }, d: { en: 'Come at your serial time with the preparation noted.', bn: 'নির্দিষ্ট প্রস্তুতিসহ সিরিয়ালের সময়ে আসুন।' } },
  { t: { en: 'Collect', bn: 'রিপোর্ট নিন' }, d: { en: 'Take your report from the counter or request it on WhatsApp.', bn: 'কাউন্টার থেকে রিপোর্ট নিন বা হোয়াটসঅ্যাপে চান।' } },
];
---
<Base title={{ en: 'Services', bn: 'সেবা' }}>
  <PageHero title={{ en: 'Our services', bn: 'আমাদের সেবা' }} lead={{ en: 'Consultation, laboratory and imaging services for the whole family.', bn: 'পুরো পরিবারের জন্য চিকিৎসা পরামর্শ, ল্যাবরেটরি ও ইমেজিং সেবা।' }} />

  <section class="section section-flush">
    <div class="wrap">
      <div class="simg-grid">
        {withImg.map((s) => (
          <article class="simg reveal">
            <figure><img src={s.image} alt={s.title.en} loading="lazy" /></figure>
            <div class="simg-body">
              <span class="scard-ic"><Icon name={s.icon} size={22} /></span>
              <h3><T t={s.title} /></h3>
              <p><T t={s.text} /></p>
              {s.key === 'pathology' && <a class="link-arrow" href="/tests?cat=hematology"><T en="See lab tests" bn="ল্যাব টেস্ট দেখুন" /> <Icon name="arrow" size={17} /></a>}
              {s.key === 'xray' && <a class="link-arrow" href="/tests?cat=xray"><T en="See X-ray prices" bn="এক্স-রে মূল্য দেখুন" /> <Icon name="arrow" size={17} /></a>}
              {s.key === 'usg' && <a class="link-arrow" href="/tests?cat=usg"><T en="See USG prices" bn="ইউএসজি মূল্য দেখুন" /> <Icon name="arrow" size={17} /></a>}
              {s.key === 'ecg' && <a class="link-arrow" href="/tests?cat=ecg"><T en="See ECG & echo" bn="ইসিজি ও ইকো দেখুন" /> <Icon name="arrow" size={17} /></a>}
              {s.key === 'opd' && <a class="link-arrow" href="/doctors"><T en="See doctors" bn="ডাক্তার দেখুন" /> <Icon name="arrow" size={17} /></a>}
              {s.key === 'emergency' && <a class="link-arrow" href={`tel:${site.phones[0].tel}`}><T en="Call now" bn="এখনই কল করুন" /> <Icon name="arrow" size={17} /></a>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-tint">
    <div class="wrap">
      <SectionHead eyebrow={{ en: 'Also available', bn: 'আরও সুবিধা' }} title={{ en: 'More ways we help', bn: 'আরও যেভাবে সহায়তা করি' }} />
      <div class="sgrid">
        {rest.map((s) => (
          <article class="scard reveal">
            <span class="scard-ic"><Icon name={s.icon} size={24} /></span>
            <h3><T t={s.title} /></h3>
            <p><T t={s.text} /></p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={{ en: 'Your visit', bn: 'আপনার ভিজিট' }} title={{ en: 'How it works', bn: 'কীভাবে কাজ করে' }} center />
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="reveal"><span class="steps-n">{i + 1}</span><h3><T t={s.t} /></h3><p><T t={s.d} /></p></li>
        ))}
      </ol>
    </div>
  </section>
</Base>
