---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import T from '../components/T.astro';
import { site, images } from '../data/site';
import { doctors } from '../data/doctors';
import { tests } from '../data/tests';
import { num } from '../lib/i18n';

const gallery = [
  { img: '/images/services/opd.svg', title: { en: 'Doctor consultation', bn: 'ডাক্তারের পরামর্শ' }, text: { en: 'Specialists from medicine, gynecology, pediatrics, surgery and more sit on fixed days. Patients get a serial in advance, so waiting is shorter and calmer.', bn: 'মেডিসিন, গাইনি, শিশু, সার্জারিসহ বিভিন্ন বিভাগের বিশেষজ্ঞ নির্দিষ্ট দিনে বসেন। আগেই সিরিয়াল পাওয়ায় অপেক্ষা কম ও স্বস্তিদায়ক।' } },
  { img: '/images/services/pathology.svg', title: { en: 'Pathology laboratory', bn: 'প্যাথলজি ল্যাবরেটরি' }, text: { en: 'Blood, urine, stool, hormone and culture tests are processed in-house. Each test lists its price, report time and preparation on our website.', bn: 'রক্ত, প্রস্রাব, মল, হরমোন ও কালচার পরীক্ষা নিজস্ব ল্যাবে হয়। প্রতিটি টেস্টের মূল্য, রিপোর্টের সময় ও প্রস্তুতি আমাদের ওয়েবসাইটে দেওয়া আছে।' } },
  { img: '/images/services/xray.svg', title: { en: 'X-ray', bn: 'এক্স-রে' }, text: { en: 'Chest, abdomen, spine and limb X-rays are taken by trained technicians and reported on the same visit.', bn: 'বুক, পেট, মেরুদণ্ড ও হাত-পায়ের এক্স-রে প্রশিক্ষিত টেকনিশিয়ান করেন এবং একই ভিজিটে রিপোর্ট দেওয়া হয়।' } },
  { img: '/images/services/usg.svg', title: { en: 'Ultrasonography', bn: 'আল্ট্রাসনোগ্রাফি' }, text: { en: 'Abdominal, pelvic and pregnancy scans in a quiet, private room, with a radiologist’s report.', bn: 'শান্ত ও গোপনীয় কক্ষে পেট, পেলভিস ও গর্ভাবস্থার স্ক্যান, সঙ্গে রেডিওলজিস্টের রিপোর্ট।' } },
  { img: '/images/services/ecg.svg', title: { en: 'ECG & echocardiography', bn: 'ইসিজি ও ইকোকার্ডিওগ্রাফি' }, text: { en: 'Heart tests for chest pain, blood pressure and routine health checks, with specialist review.', bn: 'বুকে ব্যথা, রক্তচাপ ও রুটিন চেকআপের জন্য হৃদরোগ পরীক্ষা, বিশেষজ্ঞের পর্যালোচনাসহ।' } },
  { img: '/images/services/emergency.svg', title: { en: 'Emergency & ambulance', bn: 'জরুরি সেবা ও অ্যাম্বুলেন্স' }, text: { en: 'In an emergency, call our serial numbers first so the team can prepare before you arrive.', bn: 'জরুরি অবস্থায় আগে আমাদের সিরিয়াল নম্বরে কল করুন, যাতে আপনি পৌঁছানোর আগেই টিম প্রস্তুত থাকতে পারে।' } },
];
const values = [
  { icon: 'shield', t: { en: 'Honest information', bn: 'সৎ তথ্য' }, d: { en: 'Doctor schedules and test prices are published openly and kept current.', bn: 'ডাক্তারের সময়সূচি ও টেস্ট মূল্য খোলাখুলি প্রকাশিত এবং হালনাগাদ থাকে।' } },
  { icon: 'clock', t: { en: 'Respect for time', bn: 'সময়ের প্রতি সম্মান' }, d: { en: 'Serials in advance and clear report times so you plan your day.', bn: 'আগাম সিরিয়াল ও স্পষ্ট রিপোর্টের সময়, যাতে আপনি দিনের পরিকল্পনা করতে পারেন।' } },
  { icon: 'heart', t: { en: 'Patient comfort', bn: 'রোগীর স্বস্তি' }, d: { en: 'Clean rooms, polite staff and privacy during examinations.', bn: 'পরিচ্ছন্ন কক্ষ, বিনয়ী কর্মী এবং পরীক্ষার সময় গোপনীয়তা।' } },
];
---
<Base title={{ en: 'About us', bn: 'পরিচিতি' }} description={site.name}>
  <PageHero title={{ en: 'About us', bn: 'আমাদের পরিচিতি' }} eyebrow={site.sub}
    lead={{ en: 'A neighbourhood hospital and diagnostic centre for Rajashon, Birulia and greater Savar.', bn: 'রাজাসন, বিরুলিয়া ও সাভার এলাকার মানুষের জন্য একটি হসপিটাল ও ডায়াগনস্টিক সেন্টার।' }} />

  <section class="section">
    <div class="wrap about-grid">
      <div class="about-photo reveal">
        <img src={images.building} alt={site.name.en} />
        <div class="about-badge"><strong><T t={site.short} /></strong><span><T t={site.sub} /></span></div>
      </div>
      <div class="about-copy reveal">
        <p class="eyebrow"><T en="Who we are" bn="আমরা কারা" /></p>
        <h2><T t={site.name} /></h2>
        <p><T t={{ en: 'We started with a simple idea: people in Savar should not need to travel far for a trustworthy diagnosis. Today our building brings consultation rooms, a pathology laboratory and imaging services together.', bn: 'আমাদের ভাবনা সহজ: নির্ভরযোগ্য রোগনির্ণয়ের জন্য সাভারের মানুষকে দূরে যেতে হওয়া উচিত নয়। আজ আমাদের ভবনে চেম্বার, প্যাথলজি ল্যাব ও ইমেজিং সেবা একসাথে রয়েছে।' }} /></p>
        <p><T t={{ en: 'Our address is Holding No. 163, Madhya Rajashon, Birulia Road, Savar, Dhaka — adjacent to Rajashon Government Primary School.', bn: 'আমাদের ঠিকানা হোল্ডিং নং-১৬৩, মধ্য রাজাসন, বিরুলিয়া রোড, সাভার, ঢাকা — রাজাসন সরকারী প্রাথমিক স্কুল সংলগ্ন।' }} /></p>
        {(site.license.en || site.license.bn) && <p class="licence"><Icon name="shield" size={18} /> <T t={site.license} /></p>}
        <ul class="facts">
          <li><strong><T t={num(doctors.length)} /></strong><span><T en="Doctors" bn="ডাক্তার" /></span></li>
          <li><strong><T t={num(tests.length)} /></strong><span><T en="Tests & packages" bn="টেস্ট ও প্যাকেজ" /></span></li>
          <li><strong><T en="7" bn="৭" /></strong><span><T en="Days a week" bn="দিন সপ্তাহে" /></span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section-tint">
    <div class="wrap">
      <SectionHead eyebrow={{ en: 'Our services in pictures', bn: 'ছবিতে আমাদের সেবা' }} title={{ en: 'What happens inside', bn: 'ভেতরে কী কী হয়' }} />
      <div class="story">
        {gallery.map((g, i) => (
          <article class:list={['story-row', 'reveal', { rev: i % 2 === 1 }]}>
            <figure><img src={g.img} alt={g.title.en} loading="lazy" /></figure>
            <div>
              <span class="story-n">0{i + 1}</span>
              <h3><T t={g.title} /></h3>
              <p><T t={g.text} /></p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={{ en: 'How we work', bn: 'আমরা যেভাবে কাজ করি' }} title={{ en: 'Our promises to patients', bn: 'রোগীদের প্রতি আমাদের অঙ্গীকার' }} center />
      <div class="vgrid">
        {values.map((v) => (
          <article class="vcard reveal"><span class="ccard-ic"><Icon name={v.icon} size={22} /></span><h3><T t={v.t} /></h3><p><T t={v.d} /></p></article>
        ))}
      </div>
    </div>
  </section>

  <section class="wrap">
    <div class="cta">
      <div><h2><T en="Visit us or book ahead" bn="সরাসরি আসুন বা আগেই সিরিয়াল নিন" /></h2><p><T t={site.address} /></p></div>
      <div class="cta-btns">
        <a class="btn btn-light btn-lg" href="/appointment"><T en="Book appointment" bn="অ্যাপয়েন্টমেন্ট" /></a>
        <a class="btn btn-outline-light btn-lg" href="/contact"><T en="Contact" bn="যোগাযোগ" /></a>
      </div>
    </div>
  </section>
</Base>
