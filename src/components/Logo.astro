---
import { site } from '../data/site';
import T from './T.astro';
interface Props { light?: boolean }
const { light = false } = Astro.props;
---
<a href="/" class:list={['logo', { 'logo--light': light }]} aria-label={site.name.en}>
  <svg class="logo-mark" width="44" height="44" viewBox="0 0 44 44" aria-hidden="true">
    <rect width="44" height="44" rx="12" fill="currentColor" class="logo-bg"/>
    <path d="M22 9.5c4.8 5.4 8.2 9.2 8.2 13.2a8.2 8.2 0 0 1-16.4 0c0-4 3.4-7.8 8.2-13.2z" fill="#fff" opacity=".18"/>
    <path d="M19 15h6v4h4v6h-4v4h-6v-4h-4v-6h4z" fill="#fff"/>
  </svg>
  <span class="logo-text">
    <strong><T t={site.short} /></strong>
    <small><T t={site.sub} /></small>
  </span>
</a>
