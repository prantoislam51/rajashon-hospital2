---
import { tests, categories } from '../data/tests';
import Dropdown from './Dropdown.astro';
import Icon from './Icon.astro';
import T from './T.astro';
import { taka } from '../lib/i18n';

const catLabel = Object.fromEntries(categories.map((c) => [c.key, c.label]));
const counts = Object.fromEntries(categories.map((c) => [c.key, tests.filter((t) => t.cat === c.key).length]));
const options = [
  { value: 'all', label: { en: 'All categories', bn: 'সব ক্যাটাগরি' }, count: tests.length },
  ...categories.map((c) => ({ value: c.key, label: c.label, count: counts[c.key] })),
];
---
<div class="tx" data-tests>
  <div class="tx-bar">
    <label class="tx-search">
      <Icon name="search" size={20} />
      <input type="search" data-q autocomplete="off"
        placeholder="Search a test, e.g. CBC, sugar"
        data-ph-en="Search a test, e.g. CBC, sugar" data-ph-bn="টেস্ট খুঁজুন, যেমন: সিবিসি, সুগার"
        data-aria-en="Search tests" data-aria-bn="টেস্ট খুঁজুন" aria-label="Search tests" />
      <button type="button" class="tx-clear" data-clear hidden data-aria-en="Clear search" data-aria-bn="মুছুন" aria-label="Clear search"><Icon name="close" size={16} /></button>
    </label>
    <Dropdown id="cat-dd" options={options} class="tx-dd" caption={{ en: 'Category', bn: 'ক্যাটাগরি' }} />
  </div>

  <p class="tx-meta" aria-live="polite">
    <span class="l-en"><b data-n>{tests.length}</b> tests</span>
    <span class="l-bn"><b data-nb>{tests.length}</b> টি টেস্ট</span>
    <span class="tx-sep">·</span>
    <span class="l-en">Prices in BDT</span><span class="l-bn">মূল্য টাকায়</span>
  </p>

  <div class="tx-table-wrap">
    <table class="ttable">
      <thead>
        <tr>
          <th><T en="Test" bn="টেস্ট" /></th>
          <th><T en="Category" bn="ধরন" /></th>
          <th class="num"><T en="Price" bn="মূল্য" /></th>
          <th><T en="Report" bn="রিপোর্ট" /></th>
          <th><T en="Preparation" bn="প্রস্তুতি" /></th>
        </tr>
      </thead>
      <tbody>
        {tests.map((t) => (
          <tr data-row data-cat={t.cat} data-s={`${t.name.en} ${t.name.bn} ${catLabel[t.cat].en} ${catLabel[t.cat].bn} ${t.note ?? ''}`.toLowerCase()}>
            <td class="c-name">
              <strong><T t={t.name} /></strong>
              {t.note && <small>{t.note}</small>}
            </td>
            <td class="c-cat"><span class="chip"><T t={catLabel[t.cat]} /></span></td>
            <td class="c-price num"><T t={taka(t.price)} /></td>
            <td class="c-rep"><span class="cell-l"><T en="Report" bn="রিপোর্ট" /></span><T t={t.report} /></td>
            <td class="c-prep"><span class="cell-l"><T en="Preparation" bn="প্রস্তুতি" /></span><T t={t.prep} /></td>
          </tr>
        ))}
      </tbody>
    </table>
    <div class="tx-empty" hidden>
      <Icon name="search" size={28} />
      <p><T en="No test matches your search." bn="আপনার অনুসন্ধানে কোনো টেস্ট পাওয়া যায়নি।" /></p>
      <button type="button" class="btn btn-ghost btn-sm" data-reset><T en="Show all tests" bn="সব টেস্ট দেখুন" /></button>
    </div>
  </div>

  <nav class="tx-pagination" data-pagination aria-label="Tests pagination" hidden>
    <button type="button" class="tx-page-btn tx-page-prev" data-page-prev data-aria-en="Previous page" data-aria-bn="আগের পাতা" aria-label="Previous page">
      <Icon name="chevl" size={18} />
      <span class="l-en">Back</span><span class="l-bn">আগের</span>
    </button>
    <div class="tx-page-numbers" data-page-numbers></div>
    <button type="button" class="tx-page-btn tx-page-next" data-page-next data-aria-en="Next page" data-aria-bn="পরের পাতা" aria-label="Next page">
      <span class="l-en">Next</span><span class="l-bn">পরের</span>
      <Icon name="chevr" size={18} />
    </button>
  </nav>

  <p class="tx-note">
    <Icon name="info" size={16} />
    <span class="l-en">Prices and report times are indicative and may change. Please call before visiting for the latest rates.</span>
    <span class="l-bn">মূল্য ও রিপোর্টের সময় নির্দেশক এবং পরিবর্তনযোগ্য। সর্বশেষ মূল্যের জন্য আসার আগে কল করুন।</span>
  </p>
</div>
<script>
  import '../scripts/tests.ts';
</script>
